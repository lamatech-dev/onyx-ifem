{
  "$id": "https://contracts.onyx.local/events/forecasting/ForecastGenerated.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "https://contracts.onyx.local/shared/event-envelope.schema.json"
    },
    {
      "properties": {
        "event_type": {
          "const": "ForecastGenerated"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "forecast_id",
            "title",
            "subject_ref",
            "horizon_start",
            "horizon_end",
            "method",
            "baseline_value"
          ],
          "properties": {
            "forecast_id": {
              "$ref": "https://contracts.onyx.local/shared/types.schema.json#/$defs/UuidV7"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "subject_ref": {
              "$ref": "https://contracts.onyx.local/shared/types.schema.json#/$defs/DomainObjectRef"
            },
            "horizon_start": {
              "$ref": "https://contracts.onyx.local/shared/types.schema.json#/$defs/UtcInstant"
            },
            "horizon_end": {
              "$ref": "https://contracts.onyx.local/shared/types.schema.json#/$defs/UtcInstant"
            },
            "method": {
              "type": "string",
              "enum": [
                "LINEAR",
                "MONTE_CARLO",
                "EXPERT"
              ]
            },
            "baseline_value": {
              "type": "number",
              "minimum": -1000000000000,
              "maximum": 1000000000000
            }
          }
        },
        "schema_version": {
          "const": 1
        }
      },
      "type": "object"
    }
  ],
  "title": "ONYX ForecastGenerated",
  "x-onyx-completeness": "FIELD_COMPLETE",
  "x-onyx-context": "C13",
  "x-onyx-topic": "forecasting.events"
}
