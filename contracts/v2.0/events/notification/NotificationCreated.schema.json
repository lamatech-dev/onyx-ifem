{
  "$id": "https://contracts.onyx.local/events/notification/NotificationCreated.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "https://contracts.onyx.local/shared/event-envelope.schema.json"
    },
    {
      "properties": {
        "event_type": {
          "const": "NotificationCreated"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "notification_id",
            "title",
            "body",
            "severity",
            "created_by_id"
          ],
          "properties": {
            "notification_id": {
              "$ref": "https://contracts.onyx.local/shared/types.schema.json#/$defs/UuidV7"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            "severity": {
              "type": "string",
              "enum": [
                "INFO",
                "WARNING",
                "CRITICAL"
              ]
            },
            "created_by_id": {
              "$ref": "https://contracts.onyx.local/shared/types.schema.json#/$defs/UuidV7"
            },
            "source_ref": {
              "$ref": "https://contracts.onyx.local/shared/types.schema.json#/$defs/DomainObjectRef"
            }
          }
        },
        "schema_version": {
          "const": 1
        }
      },
      "type": "object"
    }
  ],
  "title": "ONYX NotificationCreated",
  "x-onyx-completeness": "FIELD_COMPLETE",
  "x-onyx-context": "C15",
  "x-onyx-topic": "notification.events"
}
