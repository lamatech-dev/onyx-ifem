{
  "$id": "https://contracts.onyx.local/shared/event-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_context": {
      "$ref": "types.schema.json#/$defs/ActorContext"
    },
    "aggregate": {
      "$ref": "types.schema.json#/$defs/DomainObjectRef"
    },
    "aggregate_version": {
      "minimum": 0,
      "type": "integer"
    },
    "audit": {
      "$ref": "types.schema.json#/$defs/AuditMetadata"
    },
    "authority_epoch": {
      "minimum": 0,
      "type": "integer"
    },
    "causation_id": {
      "$ref": "types.schema.json#/$defs/UuidV7"
    },
    "correlation_id": {
      "$ref": "types.schema.json#/$defs/UuidV7"
    },
    "event_id": {
      "$ref": "types.schema.json#/$defs/UuidV7"
    },
    "event_type": {
      "minLength": 1,
      "type": "string"
    },
    "lifecycle_epoch": {
      "minimum": 0,
      "type": "integer"
    },
    "occurred_at": {
      "$ref": "types.schema.json#/$defs/UtcInstant"
    },
    "operation_id": {
      "$ref": "types.schema.json#/$defs/UuidV7"
    },
    "organization_id": {
      "$ref": "types.schema.json#/$defs/OrganizationId"
    },
    "payload": {
      "type": "object"
    },
    "recorded_at": {
      "$ref": "types.schema.json#/$defs/UtcInstant"
    },
    "schema_version": {
      "maximum": 65535,
      "minimum": 1,
      "type": "integer"
    },
    "vector_clock": {
      "$ref": "types.schema.json#/$defs/VectorClock"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "organization_id",
    "aggregate",
    "aggregate_version",
    "lifecycle_epoch",
    "authority_epoch",
    "operation_id",
    "actor_context",
    "occurred_at",
    "recorded_at",
    "vector_clock",
    "correlation_id",
    "audit",
    "payload"
  ],
  "title": "ONYX Canonical Event Envelope",
  "type": "object"
}
