{
  "$id": "https://contracts.onyx.local/commands/notification/ResolveRecipients.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "https://contracts.onyx.local/shared/command-envelope.schema.json"
    },
    {
      "properties": {
        "command_type": {
          "const": "ResolveRecipients"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "notification_id",
            "recipient_ids",
            "channels"
          ],
          "properties": {
            "notification_id": {
              "$ref": "https://contracts.onyx.local/shared/types.schema.json#/$defs/UuidV7"
            },
            "recipient_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "$ref": "https://contracts.onyx.local/shared/types.schema.json#/$defs/UuidV7"
              }
            },
            "channels": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "EMAIL",
                  "IN_APP",
                  "SMS",
                  "WEBHOOK"
                ]
              }
            }
          }
        },
        "schema_version": {
          "const": 1
        }
      },
      "type": "object"
    }
  ],
  "title": "ONYX ResolveRecipients",
  "x-onyx-completeness": "FIELD_COMPLETE",
  "x-onyx-context": "C15",
  "x-onyx-topic": "notification.events"
}
