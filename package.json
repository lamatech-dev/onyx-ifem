{
  "name": "onyx-ifem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "npm run validate:contracts && npm run validate:openapi && npm run validate:monitoring && npm run typecheck && npm test",
    "db:backup": "node --experimental-strip-types tools/database-recovery.ts backup",
    "db:restore": "node --experimental-strip-types tools/database-recovery.ts restore",
    "db:verify": "node --experimental-strip-types tools/database-recovery.ts verify",
    "dev:stack": "node --experimental-strip-types tools/local-stack.ts",
    "openapi": "node --experimental-strip-types tools/print-openapi.ts",
    "start": "npm run start:api",
    "start:api": "node --experimental-strip-types src/mission/server.ts",
    "start:mission": "node --experimental-strip-types src/mission/server.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:stack": "node --experimental-strip-types --test integration/local-stack.test.ts",
    "typecheck": "tsc --noEmit",
    "validate:openapi": "node --experimental-strip-types tools/validate-openapi.ts",
    "validate:contracts": "node --experimental-strip-types tools/validate-contracts.ts",
    "validate:monitoring": "node --experimental-strip-types tools/validate-monitoring.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  }
}
